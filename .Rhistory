library(ggplot2)
library(tidyr)
ALPHA_MIN <- 10
ALPHA_MAX <- 85
Vo_MIN <- 10
Vo_MAX <- 60
Ve_MIN <- 8
Ve_MAX <- 35
HEAVY_ALPHA <- 0.001
HEAVY_GAMMA <- 0.85
LIMITE <- 250
TOLERANCE <- 0.006
DATE <- 5
M_N <- 12
M_I <- 5
LAMBDA <- 0.02
V_E <- 9
ALPHA <- 60
V_0 <- 12
# A FUNCTION SPECIFICALLY DESIGNED TO MONITOR AND ENFORCE THE VARIOUS CONSTRAINTS APPLIED TO THE OPTIMIZATION PARAMETERS
contrainte <- function(alpha, Vo, Ve, alpha_min = ALPHA_MIN, alpha_max = ALPHA_MAX, Vo_min = Vo_MIN, Vo_max = Vo_MAX, Ve_min = Ve_MIN, Ve_max = Ve_MAX){
if(alpha >= alpha_min & alpha <= alpha_max & Vo >= Vo_min & Vo <= Vo_max & Ve >= Ve_min & Ve <= Ve_max){
return(TRUE)
}else{
return(FALSE)
}
}
# THE DETERMINISTIC FORM OF THE GRADIENT FOR OUR ERROR FUNCTION (Ecart()), WHICH WE ARE SEEKING TO MINIMIZE.
gradient_ecart_x <- function(t, lambda = LAMBDA, m_0 = M_I, M_0 = M_N, Ve = V_E, alpha = ALPHA, Vo = V_0){#gradient de notre fonction objectif par rapport aux paramètres
gradient_alpha <- (-(M_0+m_0)*Vo*sin(alpha)/(lambda*M_0))*log((M_0*exp(lambda*t) + m_0)/(M_0+m_0))
gradient_Vo <- (-(M_0 + m_0)*cosd(alpha)/(lambda*M_0))*log((M_0*exp(lambda*t) + m_0)/(M_0 + m_0))
gradient_Ve <- (m_0/M_0)*(2*log((M_0*exp(lambda*t) + m_0)/(M_0 + m_0)) - lambda*t)
return(gradient_alpha + gradient_Vo + gradient_Ve)
}
# THE HEAVY BALL ALGORITHM
heavy_ball <- function(t = DATE, heavy_alpha = HEAVY_ALPHA, heavy_gamma = HEAVY_GAMMA, alpha_min = ALPHA_MIN, alpha_max = ALPHA_MAX, Vo_min = Vo_MIN, Vo_max = Vo_MAX, Ve_min = Ve_MIN, Ve_max = Ve_MAX, limite = LIMITE, tolerance = TOLERANCE, lambda = LAMBDA, m_0 = M_I, M_0 = M_N){
#  WE PREPARE THE ARRAYS (or DATA TABLES) THAT WILL PROGRESSIVELY STORE THE VALUES OF OUR DECISION PARAMETERS
historique_gradient <- numeric(limite)
historique_alpha <- c(alpha_max)
historique_Vo <- c(Vo_max)
historique_Ve <- c(Ve_max)
evolution <- c(etape)
# WE INITIALIZE THE DECISION VARIABLES
alpha <- alpha_max
Vo <- Vo_max
Ve <- Ve_max
V_k <- 0
for (etape in 1:LIMITE) {
if(contrainte(alpha, Vo, Ve)==TRUE){
# ON CALCULE LE GRADIENT A CHAQUE ETAPE
grad <- gradient_x(t, lambda, m_0, M_0, Ve, alpha, Vo)
V_k <- heavy_gamma*V_k - heavy_alpha*grad
alpha <- alpha + V_k
Vo <- Vo + V_k
Ve <- Ve + V_k
historique_alpha <- c(historique_alpha, alpha)
historique_Vo <- c(historique_Vo, Vo)
historique_Ve <- c(historique_Ve, Ve)
evolution <- c(evolution, etape)
historique_gradient[etape] <- grad
cat("\n", etape, " :: ", contrainte(alpha, Vo, Ve), " :: ", tolerance-abs(grad), ", alpha :: ", alpha, ", Vo :: ", Vo, ", Ve :: ", Ve)
if(abs(grad)<tolerance){# ON EVALUE LE GRADIENT A CHAQUE ETAPE PAR RAPPORT A LA VALEUR DE TOLERANCE
cat("\n\nConvergence atteinte à l'iteration ", etape, "\n")
# WE COLLECT ALL THE VALUES OF THE DECISION VARIABLES TESTED UP TO THE POINT OF CONVERGENCE.
# THESE VALUES WILL ALLOW US TO PLOT (or VISUALIZE) THEIR CONVERGENCE PATHS
historique_gradient <- historique_gradient[1:etape]
historique_alpha <- historique_alpha[1:etape]
historique_Vo <- historique_Vo[1:etape]
historique_Ve <- historique_Ve[1:etape]
evolution <- evolution[1:etape]
# WE CREATE THE CORRESPONDING DATA FRAME
projectile <- data.frame(
evolution = evolution,
alpha = historique_alpha,
Vo = historique_Vo,
Ve = historique_Ve,
Gradient = historique_gradient
)
# View(projectile)
# WE DISPLAY (or PRINT) THE OPTIMAL PARAMETERS FOUND BY THE ALGORITHM
cat("Les parametres optimaux sont :\nalpha :: ", historique_alpha[etape], "° , ",
"\nVo   :: ", historique_Vo[etape],
"\nVe   :: ", historique_Ve[etape])
# WE CAN CREATE A FIGURE CONTAINING THE FOUR GRAPHS
projectile_long <- pivot_longer(
projectile,
cols = c(alpha, Vo, Ve, Gradient),
names_to = "parametre",
values_to = "valeur"
)
ggplot(projectile_long, aes(x = evolution, y = valeur, color = parametre)) +
geom_line(size = 1.2) +
facet_wrap(~ parametre, scales = "free_y", ncol = 2,
labeller = labeller(parametre = c(
alpha = "Angle α",
Vo = "Vitesse initiale V₀",
Ve = "Vitesse d'éjection Vₑ",
Gradient = "Norme du gradient"
))) +
scale_color_manual(values = c(
alpha = "#E63946",
Vo = "#457B9D",
Ve = "#2A9D8F",
Gradient = "#F4A261"
)) +
labs(title = "Convergence des paramètres - Algorithme de la boule pesante",
x = "Itération",
y = "Valeur") +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5, size = 16, face = "bold"),
strip.text = element_text(size = 12, face = "bold"),
legend.position = "none",
panel.grid.minor = element_blank()
)
# WE CAN SAVE THE PLOT AS A PICTURE
ggsave("convergence.png", width = 12, height = 8, dpi = 600)
# WE CAN ALSO SAVE THE PROJECTILE DATAS AS A CSV FILE
write.csv(projectile, "Donnees_projectile.csv")
break
}
}
}
}
# THE HEAVY BALL ALGORITHM
heavy_ball <- function(t = DATE, heavy_alpha = HEAVY_ALPHA, heavy_gamma = HEAVY_GAMMA, alpha_min = ALPHA_MIN, alpha_max = ALPHA_MAX, Vo_min = Vo_MIN, Vo_max = Vo_MAX, Ve_min = Ve_MIN, Ve_max = Ve_MAX, limite = LIMITE, tolerance = TOLERANCE, lambda = LAMBDA, m_0 = M_I, M_0 = M_N){
#  WE PREPARE THE ARRAYS (or DATA TABLES) THAT WILL PROGRESSIVELY STORE THE VALUES OF OUR DECISION PARAMETERS
historique_gradient <- numeric(limite)
historique_alpha <- c(alpha_max)
historique_Vo <- c(Vo_max)
historique_Ve <- c(Ve_max)
evolution <- c(etape)
# WE INITIALIZE THE DECISION VARIABLES
alpha <- alpha_max
Vo <- Vo_max
Ve <- Ve_max
V_k <- 0
for (etape in 1:LIMITE) {
if(contrainte(alpha, Vo, Ve)==TRUE){
# ON CALCULE LE GRADIENT A CHAQUE ETAPE
grad <- gradient_x(t, lambda, m_0, M_0, Ve, alpha, Vo)
V_k <- heavy_gamma*V_k - heavy_alpha*grad
alpha <- alpha + V_k
Vo <- Vo + V_k
Ve <- Ve + V_k
historique_alpha <- c(historique_alpha, alpha)
historique_Vo <- c(historique_Vo, Vo)
historique_Ve <- c(historique_Ve, Ve)
evolution <- c(evolution, etape)
historique_gradient[etape] <- grad
cat("\n", etape, " :: ", contrainte(alpha, Vo, Ve), " :: ", tolerance-abs(grad), ", alpha :: ", alpha, ", Vo :: ", Vo, ", Ve :: ", Ve)
if(abs(grad)<tolerance){# ON EVALUE LE GRADIENT A CHAQUE ETAPE PAR RAPPORT A LA VALEUR DE TOLERANCE
cat("\n\nConvergence atteinte à l'iteration ", etape, "\n")
# WE COLLECT ALL THE VALUES OF THE DECISION VARIABLES TESTED UP TO THE POINT OF CONVERGENCE.
# THESE VALUES WILL ALLOW US TO PLOT (or VISUALIZE) THEIR CONVERGENCE PATHS
historique_gradient <- historique_gradient[1:etape]
historique_alpha <- historique_alpha[1:etape]
historique_Vo <- historique_Vo[1:etape]
historique_Ve <- historique_Ve[1:etape]
evolution <- evolution[1:etape]
# WE CREATE THE CORRESPONDING DATA FRAME
projectile <- data.frame(
evolution = evolution,
alpha = historique_alpha,
Vo = historique_Vo,
Ve = historique_Ve,
Gradient = historique_gradient
)
View(projectile)
# WE DISPLAY (or PRINT) THE OPTIMAL PARAMETERS FOUND BY THE ALGORITHM
cat("Les parametres optimaux sont :\nalpha :: ", historique_alpha[etape], "° , ",
"\nVo   :: ", historique_Vo[etape],
"\nVe   :: ", historique_Ve[etape])
# TURNING THE LARGE FRAME INTO A LONG FRAME EASIER TO MANAGE
projectile_long <- pivot_longer(
projectile,
cols = c(alpha, Vo, Ve, Gradient),
names_to = "parametre",
values_to = "valeur"
)
# CREATING AND SAVING THE PLOTS ON A PICTURE
ggplot(projectile_long, aes(x = evolution, y = valeur)) +
geom_line(color = "blue", linewidth = 1) +  # linewidth au lieu de size
facet_wrap(~ parametre, scales = "free_y", ncol = 2) +
labs(title = "Évolution des paramètres", x = "Itération", y = "Valeur") +
theme_minimal()
ggsave("graphiques_projectile.png", width = 10, height = 8, dpi = 300)
write.csv(projectile, "Donnees_projectile.csv")
break
}
}
}
}
